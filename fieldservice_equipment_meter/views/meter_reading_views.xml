<odoo>
    <record id="meter_reading_list" model="ir.ui.view">
        <field name="name">fsm.equipment.meter.reading.list</field>
        <field name="model">fsm.equipment.meter.reading</field>
        <field name="arch" type="xml">
            <list><field name="reading_date"/><field name="equipment_id"/><field name="value"/><field name="unit"/><field name="source"/></list>
        </field>
    </record>
    <record id="meter_reading_form" model="ir.ui.view">
        <field name="name">fsm.equipment.meter.reading.form</field>
        <field name="model">fsm.equipment.meter.reading</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="equipment_id"/><field name="reading_date"/><field name="value"/><field name="unit"/><field name="source"/><field name="note"/></group></sheet></form>
        </field>
    </record>
    <record id="action_meter_reading" model="ir.actions.act_window">
        <field name="name">Meter Readings</field>
        <field name="res_model">fsm.equipment.meter.reading</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
