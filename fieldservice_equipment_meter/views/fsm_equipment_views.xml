<odoo>
    <record id="fsm_equipment_form_meter" model="ir.ui.view">
        <field name="name">fsm.equipment.form.meter</field>
        <field name="model">fsm.equipment</field>
        <field name="inherit_id" ref="fieldservice.fsm_equipment_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_meter_readings" type="object" class="oe_stat_button" icon="fa-tachometer">
                    <field name="meter_reading_count" widget="statinfo" string="Meter Readings"/>
                </button>
            </div>
            <group id="secondary" position="inside">
                <group string="Meter">
                    <field name="current_meter_value"/>
                    <field name="current_meter_unit"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
