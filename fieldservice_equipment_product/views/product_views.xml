<odoo>
    <record id="product_template_form_fsm_equipment" model="ir.ui.view">
        <field name="name">product.template.form.fsm.equipment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fsm_equipment" type="object" class="oe_stat_button" icon="fa-cogs">
                    <field name="fsm_equipment_count" widget="statinfo" string="Field Service Equipment"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
